<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prefer explicit package references in test projects instead of pulling the entire shared framework.
         Add only the specific ASP.NET Core packages your tests require (e.g. TestHost, Mvc.Testing). -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="7.0.0" />
  </ItemGroup>
</Project>
